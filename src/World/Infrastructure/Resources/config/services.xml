<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <parameters>
        <parameter key="phpmud.tick_interval">60.0</parameter>
    </parameters>

    <services>
        <service id="phpmud.domain.service.movement_policy" class="PHPMud\World\Domain\Movement\MovementPolicy" />

        <service id="phpmud.application.movement.view.location_view_factory" class="PHPMud\World\Application\Movement\LocationViewFactory">
            <argument type="service" id="phpmud.domain.repository.location" />
        </service>

        <service id="phpmud.application.movement.command_executor.move" class="PHPMud\World\Application\Movement\Move\MoveCommandExecutor">
            <argument type="service" id="phpmud.domain.repository.character" />
            <argument type="service" id="phpmud.domain.repository.location" />
            <argument type="service" id="phpmud.domain.service.movement_policy" />
            <argument type="service" id="phpmud.application.movement.view.location_view_factory" />
            <argument type="service" id="phpmud.application.domain_event_dispatcher" />
        </service>

        <service id="phpmud.application.movement.command_executor.look" class="PHPMud\World\Application\Movement\Look\LookCommandExecutor">
            <argument type="service" id="phpmud.domain.repository.character" />
            <argument type="service" id="phpmud.domain.repository.location" />
            <argument type="service" id="phpmud.application.movement.view.location_view_factory" />
        </service>

        <service id="phpmud.application.help.command_executor.unknown" class="PHPMud\World\Application\Help\Unknown\UnknownCommandExecutor">
        </service>

        <service id="phpmud.application.character.command_executor.whoami" class="PHPMud\World\Application\Character\WhoAmI\WhoAmICommandExecutor">
            <argument type="service" id="phpmud.domain.repository.character" />
        </service>

        <service id="phpmud.application.access.command_executor.identify_character" class="PHPMud\World\Application\Access\IdentifyCharacter\IdentifyCharacterCommandExecutor">
            <argument type="service" id="phpmud.domain.repository.character" />
        </service>

        <service id="phpmud.application.access.command_executor.authenticate_character" class="PHPMud\World\Application\Access\AuthenticateCharacter\AuthenticateCharacterCommandExecutor">
            <argument type="service" id="phpmud.domain.repository.character" />
        </service>

        <service id="phpmud.application.time.command_executor.tick" class="PHPMud\World\Application\Time\Tick\TickCommandExecutor">
            <argument type="service" id="phpmud.domain.repository.world_clock" />
            <argument type="service" id="phpmud.application.domain_event_dispatcher" />
        </service>

        <service id="phpmud.application.time.subscriber.notify_day_phase_started" class="PHPMud\World\Application\Time\DayPhaseStarted\NotifyDayPhaseStarted">
            <argument type="service" id="phpmud.application.notifier" />
        </service>

        <service id="phpmud.application.movement.subscriber.notify_character_moved" class="PHPMud\World\Application\Movement\CharacterMoved\NotifyCharacterMoved">
            <argument type="service" id="phpmud.domain.repository.character" />
            <argument type="service" id="phpmud.application.notifier" />
        </service>

        <service id="phpmud.application.domain_event_dispatcher" class="PHPMud\World\Application\DomainEventDispatcher">
            <call method="addSubscriber">
                <argument>PHPMud\World\Domain\Time\DayPhaseStarted</argument>
                <argument type="service" id="phpmud.application.time.subscriber.notify_day_phase_started" />
            </call>
            <call method="addSubscriber">
                <argument>PHPMud\World\Domain\Character\CharacterMoved</argument>
                <argument type="service" id="phpmud.application.movement.subscriber.notify_character_moved" />
            </call>
        </service>

        <service id="phpmud.application.command_router" class="PHPMud\World\Application\CommandRouter">
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Access\IdentifyCharacter\IdentifyCharacterCommand</argument>
                <argument type="service" id="phpmud.application.access.command_executor.identify_character" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Access\AuthenticateCharacter\AuthenticateCharacterCommand</argument>
                <argument type="service" id="phpmud.application.access.command_executor.authenticate_character" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Movement\Move\MoveCommand</argument>
                <argument type="service" id="phpmud.application.movement.command_executor.move" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Movement\Look\LookCommand</argument>
                <argument type="service" id="phpmud.application.movement.command_executor.look" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Help\Unknown\UnknownCommand</argument>
                <argument type="service" id="phpmud.application.help.command_executor.unknown" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Character\WhoAmI\WhoAmICommand</argument>
                <argument type="service" id="phpmud.application.character.command_executor.whoami" />
            </call>
            <call method="addExecutorForCommand">
                <argument>PHPMud\World\Application\Time\Tick\TickCommand</argument>
                <argument type="service" id="phpmud.application.time.command_executor.tick" />
            </call>
        </service>

        <service id="phpmud.domain.repository.filesystem.location" class="PHPMud\World\Infrastructure\Repository\Filesystem\LocationRepository">
            <argument>/tmp/phpmud.location</argument>
        </service>
        <service id="phpmud.domain.repository.location" alias="phpmud.domain.repository.filesystem.location" />

        <service id="phpmud.domain.repository.filesystem.character" class="PHPMud\World\Infrastructure\Repository\Filesystem\CharacterRepository">
            <argument>/tmp/phpmud.character</argument>
        </service>
        <service id="phpmud.domain.repository.character" alias="phpmud.domain.repository.filesystem.character" />

        <service id="phpmud.domain.repository.filesystem.world_clock" class="PHPMud\World\Infrastructure\Repository\Filesystem\WorldClockRepository">
            <argument>/tmp/phpmud.world_clock</argument>
        </service>
        <service id="phpmud.domain.repository.world_clock" alias="phpmud.domain.repository.filesystem.world_clock" />

        <service id="phpmud.delivery.telnet.command_resolver" class="PHPMud\World\Infrastructure\Delivery\Telnet\CommandResolver">
        </service>

        <service id="phpmud.delivery.telnet.command_response_renderer" class="PHPMud\World\Infrastructure\Delivery\Telnet\CommandResponseRenderer">
        </service>

        <service id="phpmud.delivery.telnet.client_handler" class="PHPMud\World\Infrastructure\Delivery\Telnet\TelnetClientHandler">
            <argument type="service" id="phpmud.delivery.telnet.command_resolver" />
            <argument type="service" id="phpmud.application.command_router" />
        </service>

        <service id="phpmud.server.client_registry" class="PHPMud\World\Infrastructure\Server\ClientRegistry" />

        <service id="phpmud.server.client_notifier" class="PHPMud\World\Infrastructure\Server\ClientNotifier">
            <argument type="service" id="phpmud.server.client_registry" />
        </service>
        <service id="phpmud.application.notifier" alias="phpmud.server.client_notifier" />

        <service id="phpmud.server.ticker" class="PHPMud\World\Infrastructure\Server\Ticker">
            <argument>%phpmud.tick_interval%</argument>
            <argument type="service" id="phpmud.application.command_router" />
        </service>

        <service id="phpmud.delivery.telnet.server" class="PHPMud\World\Infrastructure\Delivery\Telnet\TelnetServer">
            <argument>127.0.0.1:10666</argument>
            <argument type="service" id="phpmud.delivery.telnet.client_handler" />
            <argument type="service" id="phpmud.server.client_registry" />
            <argument type="service" id="phpmud.delivery.telnet.command_response_renderer" />
        </service>

        <service id="phpmud.server.game" class="PHPMud\World\Infrastructure\Server\GameServer">
            <argument type="service" id="phpmud.server.ticker" />
            <argument type="service" id="phpmud.delivery.telnet.server" />
        </service>
    </services>
</container>
