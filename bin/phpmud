#!/usr/bin/env php
<?php

declare(strict_types=1);

use PHPMud\World\Infrastructure\Kernel;
use PHPMud\World\Infrastructure\Delivery\Telnet\TelnetServer;

require_once __DIR__ . '/../vendor/autoload.php';

$kernel = new Kernel($_ENV['APP_ENV'] ?? $_SERVER['APP_ENV'] ?? 'dev');
$kernel->boot();

$container = $kernel->getContainer();
$tickInterval = getenv('PHPMUD_TICK_INTERVAL');
if (false !== $tickInterval) {
    $container->setParameter('phpmud.tick_interval', (float) $tickInterval);
}
echo 'Starting PHPMud server...' . PHP_EOL;
/** @var TelnetServer $server */
$server = $container->get('phpmud.delivery.telnet.server');
$server->listen();
