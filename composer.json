{
    "require-dev": {
        "ext-sockets": "*",
        "behat/behat": "^3.23",
        "symplify/easy-coding-standard": "^12.5",
        "phpstan/phpstan": "^2.1",
        "amphp/websocket-client": "^2"
    },
    "autoload": {
        "psr-4": {
            "PHPMud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPMud\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "symfony/uid": "^7.3",
        "webgriffe/in-memory-repository": "^0.3.0",
        "webmozart/assert": "^1.11",
        "symfony/dependency-injection": "^7.3",
        "amphp/socket": "^2.3",
        "amphp/websocket-server": "^4",
        "amphp/http-server-router": "^2",
        "amphp/http-server-static-content": "^2"
    },
    "scripts": {
        "start": "bin/phpmud > /tmp/phpmud.log 2>&1 & echo $! > /tmp/phpmud.pid",
        "stop": "kill $(cat /tmp/phpmud.pid); rm /tmp/phpmud.pid",
        "ecs": "vendor/bin/ecs check",
        "phpstan": "vendor/bin/phpstan analyse -l max src/",
        "behat": "vendor/bin/behat",
        "test": [
            "@ecs",
            "@phpstan",
            "@behat"
        ]
    }
}
