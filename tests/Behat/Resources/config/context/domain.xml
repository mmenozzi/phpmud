<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="true" />

        <service id="phpmud.behat.domain.notifier" class="PHPMud\Tests\Behat\Service\RecordingNotifier" />

        <service id="phpmud.behat.domain.domain_event_dispatcher" class="PHPMud\World\Application\DomainEventDispatcher">
            <call method="addSubscriber">
                <argument>PHPMud\World\Domain\Time\DayPhaseStarted</argument>
                <argument type="service">
                    <service class="PHPMud\World\Application\Time\DayPhaseStarted\NotifyDayPhaseStarted">
                        <argument type="service" id="phpmud.behat.domain.notifier" />
                    </service>
                </argument>
            </call>
            <call method="addSubscriber">
                <argument>PHPMud\World\Domain\Character\CharacterMoved</argument>
                <argument type="service">
                    <service class="PHPMud\World\Application\Movement\CharacterMoved\NotifyCharacterMoved">
                        <argument type="service" id="phpmud.domain.repository.in_memory.character" />
                        <argument type="service" id="phpmud.behat.domain.notifier" />
                    </service>
                </argument>
            </call>
        </service>

        <service id="phpmud.behat.context.domain.movement" class="PHPMud\Tests\Behat\Context\Domain\MovementContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
            <argument type="service" id="phpmud.domain.repository.in_memory.location" />
            <argument type="service">
                <service class="PHPMud\World\Application\Movement\Move\MoveCommandExecutor">
                    <argument type="service" id="phpmud.domain.repository.in_memory.character" />
                    <argument type="service" id="phpmud.domain.repository.in_memory.location" />
                    <argument type="service" id="phpmud.domain.service.movement_policy" />
                    <argument type="service">
                        <service class="PHPMud\World\Application\Movement\LocationViewFactory">
                            <argument type="service" id="phpmud.domain.repository.in_memory.location" />
                        </service>
                    </argument>
                    <argument type="service" id="phpmud.behat.domain.domain_event_dispatcher" />
                </service>
            </argument>
            <argument type="service" id="phpmud.behat.domain.notifier" />
        </service>

        <service id="phpmud.behat.context.domain.access" class="PHPMud\Tests\Behat\Context\Domain\AccessContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
            <argument type="service">
                <service class="PHPMud\World\Application\Access\IdentifyCharacter\IdentifyCharacterCommandExecutor">
                    <argument type="service" id="phpmud.domain.repository.in_memory.character" />
                </service>
            </argument>
            <argument type="service">
                <service class="PHPMud\World\Application\Access\AuthenticateCharacter\AuthenticateCharacterCommandExecutor">
                    <argument type="service" id="phpmud.domain.repository.in_memory.character" />
                </service>
            </argument>
            <argument type="service">
                <service class="PHPMud\World\Application\Character\WhoAmI\WhoAmICommandExecutor">
                    <argument type="service" id="phpmud.domain.repository.in_memory.character" />
                </service>
            </argument>
        </service>

        <service id="phpmud.behat.context.domain.time" class="PHPMud\Tests\Behat\Context\Domain\TimeContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
            <argument type="service">
                <service class="PHPMud\World\Application\Time\Tick\TickCommandExecutor">
                    <argument type="service" id="phpmud.domain.repository.in_memory.world_clock" />
                    <argument type="service" id="phpmud.behat.domain.domain_event_dispatcher" />
                </service>
            </argument>
            <argument type="service" id="phpmud.behat.domain.notifier" />
        </service>
    </services>
</container>
