<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="true" />

        <service id="phpmud.behat.context.telnet.movement" class="PHPMud\Tests\Behat\Context\Telnet\MovementContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
        </service>

        <service id="phpmud.behat.context.telnet.access" class="PHPMud\Tests\Behat\Context\Telnet\AccessContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
        </service>

        <service id="phpmud.behat.context.telnet.time" class="PHPMud\Tests\Behat\Context\Telnet\TimeContext">
            <argument type="service" id="phpmud.behat.shared_storage" />
        </service>
    </services>
</container>
